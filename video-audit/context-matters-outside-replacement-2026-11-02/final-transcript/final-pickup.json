    {
      "start": 0.02,
      "end": 3.44,
      "text": "Having your assignment open on your laptop doesn't mean AI can use it."
    },
    {
      "start": 3.96,
      "end": 7.74,
      "text": "Share the relevant material in the chat or use the app's tools to make it available."
    },
    {
      "start": 8.6,
      "end": 11.38,
      "text": "And don't assume AI has everything you said in another chat."
    },
    {
      "start": 12.04,
      "end": 17.02,
      "text": "Memory and projects can bring information forward, but you may still need to supply missing details."
    },
    {
      "start": 17.94,
      "end": 21.16,
      "text": "Before you ask, check. Does AI have the information it needs?"
    }
