  "segments": [
    {
      "start": 0.0,
      "end": 4.28,
      "text": "Make Gemini Notebook your primary study tool when you're reviewing your class materials."
    },
    {
      "start": 5.2,
      "end": 11.96,
      "text": "This keeps all of your work securely grounded in the exact notes, slides, and sources your teacher actually provided."
    },
    {
      "start": 13.22,
      "end": 15.76,
      "text": "This graphic shows exactly how Gemini Notebook works."
    },
    {
      "start": 16.8,
      "end": 24.92,
      "text": "First, you upload your materials. These can be personal notes, PDFs, presentation slides, images, websites, articles, or YouTube videos."
    },
    {
      "start": 25.86,
      "end": 34.68,
      "text": "From those inputs, you get back custom quizzes, flashcards, study guides, audio and video overviews, mind maps, and more."
    },
    {
      "start": 35.6,
      "end": 40.12,
      "text": "You turn your existing class materials directly into the specific study tools you need."
    }
  ],
