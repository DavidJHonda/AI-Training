  "segments": [
    {
      "start": 0.0,
      "end": 3.84,
      "text": "If you look at YouTube or TikTok or listen to friends and family,"
    },
    {
      "start": 4.28,
      "end": 6.52,
      "text": "you'll hear a lot of opinions about AI."
    },
    {
      "start": 7.28,
      "end": 9.16,
      "text": "It can feel like an endless amount of noise."
    },
    {
      "start": 9.88,
      "end": 11.54,
      "text": "So who do you actually believe?"
    },
    {
      "start": 12.22,
      "end": 16.16,
      "text": "Let's cut through that noise and look at the people who build AI for a living."
    },
    {
      "start": 16.84,
      "end": 19.3,
      "text": "You might expect them to agree, but they don't."
    },
    {
      "start": 20.06,
      "end": 22.88,
      "text": "Same field, same evidence, very different bets."
    },
    {
      "start": 24.2,
      "end": 26.22,
      "text": "First, the optimist, Dario Amade."
    },
    {
      "start": 26.22,
      "end": 30.22,
      "text": "He helped build GPT-2 and GPT-3 at OpenAI,"
    },
    {
      "start": 30.8,
      "end": 33.26,
      "text": "and then founded Anthropic, the company behind Claude."
    }
  ],
