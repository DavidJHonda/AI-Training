  "segments": [
    {
      "start": 0.05,
      "end": 3.69,
      "text": "School is where you get to build what you bring to the work."
    },
    {
      "start": 4.33,
      "end": 7.83,
      "text": "The formal lesson is complete, and that foundation is now set."
    },
    {
      "start": 8.63,
      "end": 11.59,
      "text": "The opportunity to learn is already in front of you."
    },
    {
      "start": 12.19,
      "end": 18.41,
      "text": "You don't have to wait for another classroom or another assignment to take the next step in your own environment."
    },
    {
      "start": 19.37,
      "end": 21.01,
      "text": "Choose something you want to get better at."
    },
    {
      "start": 21.59,
      "end": 24.39,
      "text": "The action you take now is entirely up to you."
    },
    {
      "start": 24.95,
      "end": 25.39,
      "text": "Start there."
    }
  ],
