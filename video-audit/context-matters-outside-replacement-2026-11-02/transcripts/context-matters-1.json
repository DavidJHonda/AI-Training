  "segments": [
    {
      "start": 0.0,
      "end": 3.9,
      "text": "Having your assignment open on your laptop doesn't mean AI can use it."
    },
    {
      "start": 4.48,
      "end": 6.36,
      "text": "Share the relevant material in the chat,"
    },
    {
      "start": 6.82,
      "end": 8.7,
      "text": "or use the app's tools to make it available."
    },
    {
      "start": 9.74,
      "end": 12.98,
      "text": "And don't assume AI has everything you said in another chat."
    },
    {
      "start": 14.08,
      "end": 16.2,
      "text": "Memory and projects can bring information forward,"
    },
    {
      "start": 16.52,
      "end": 18.8,
      "text": "but you may still need to supply missing details."
    },
    {
      "start": 19.7,
      "end": 21.16,
      "text": "So always remember this rule."
    },
    {
      "start": 21.92,
      "end": 23.04,
      "text": "Before you ask, check."
    },
    {
      "start": 23.74,
      "end": 25.62,
      "text": "Does AI have the information it needs?"
    }
  ],
