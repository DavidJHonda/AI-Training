  "segments": [
    {
      "start": 0.0,
      "end": 4.56,
      "text": "When you are studying for a course, Gemini Notebook should be your primary study tool."
    },
    {
      "start": 5.16,
      "end": 10.96,
      "text": "It keeps your work entirely grounded in the exact notes, slides, and sources your teacher gave you,"
    },
    {
      "start": 11.3,
      "end": 13.56,
      "text": "so you do not have to rely on outside information."
    },
    {
      "start": 14.6,
      "end": 15.72,
      "text": "Here's how the process works."
    },
    {
      "start": 16.44,
      "end": 22.0,
      "text": "You upload your raw materials, notes, PDFs, slides, images, articles, and YouTube videos."
    },
    {
      "start": 22.54,
      "end": 28.62,
      "text": "In return, you get quizzes, flashcards, study guides, audio video overviews, and mind maps."
    },
    {
      "start": 28.62,
      "end": 32.64,
      "text": "Turn class materials directly into study tools you need."
    }
  ],
