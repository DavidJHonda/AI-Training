    {
      "v1_frames": [
        691,
        756
      ],
      "v1_seconds": [
        23.033333333333335,
        25.2
      ],
      "text": "Let\u2019s look at a concrete example."
    },
    {
      "v1_frames": [
        1510,
        1600
      ],
      "v1_seconds": [
        50.333333333333336,
        53.333333333333336
      ],
      "text": "That praise could apply to almost any Gatsby essay."
    },
    {
      "v1_frames": [
        1880,
        2300
      ],
      "v1_seconds": [
        62.666666666666664,
        76.66666666666667
      ],
      "text": "This version is useful \u2026 Empty praise only improves how you feel in the moment."
    },
    {
      "v1_frames": [
        2484,
        2622
      ],
      "v1_seconds": [
        82.8,
        87.4
      ],
      "text": "This diagram outlines why AI leans so heavily toward flattery."
    },
    {
      "v1_frames": [
        4828,
        4928
      ],
      "v1_seconds": [
        160.93333333333334,
        164.26666666666668
      ],
      "text": "This table outlines ways to fight the flattery trap."
    },
    {
      "v1_frames": [
        5181,
        5260
      ],
      "v1_seconds": [
        172.7,
        175.33333333333334
      ],
      "text": "Instead, hold back your verdict."
    },
    {
      "v1_frames": [
        5402,
        5552
      ],
      "v1_seconds": [
        180.06666666666666,
        185.06666666666666
      ],
      "text": "A neutral question gives the AI less of your own confidence to reflect back at you."
    },
    {
      "v1_frames": [
        6025,
        6140
      ],
      "v1_seconds": [
        200.83333333333334,
        204.66666666666666
      ],
      "text": "Now you have given the AI specific targets to locate."
    },
    {
      "v1_frames": [
        6965,
        7168
      ],
      "v1_seconds": [
        232.16666666666666,
        238.93333333333334
      ],
      "text": "Each of these moves works because you are replacing a request for validation with a concrete standard for the AI to meet."
    },
    {
      "v1_frames": [
        7557,
        7661
      ],
      "v1_seconds": [
        251.9,
        255.36666666666667
      ],
      "text": "Ask AI to improve the work, not approve of you."
    },
    {
      "v1_frames": [
        7920,
        8197
      ],
      "v1_seconds": [
        264.0,
        273.23333333333335
      ],
      "text": "You fall into the trap \u2026 This comparison chart shows how easily that happens."
    },
    {
      "v1_frames": [
        8440,
        8650
      ],
      "v1_seconds": [
        281.3333333333333,
        288.3333333333333
      ],
      "text": "Y2 minus Y1 over X2 minus X1. It is a perfectly efficient answer."
    },
    {
      "v1_frames": [
        9498,
        9612
      ],
      "v1_seconds": [
        316.6,
        320.4
      ],
      "text": "Both answered the initial question, but only one ended there."
    },
    {
      "v1_frames": [
        10005,
        10076
      ],
      "v1_seconds": [
        333.5,
        335.8666666666667
      ],
      "text": "This compares two design strategies."
    }
  ],
  "preserved_exception": "The praise literally gets baked into the system.",
