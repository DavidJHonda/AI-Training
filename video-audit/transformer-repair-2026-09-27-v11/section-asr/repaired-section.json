    {
      "start": 0.0,
      "end": 2.14,
      "text": "In our examples, please turn on the light."
    },
    {
      "start": 2.52,
      "end": 4.94,
      "text": "Turn on tells the AI light means brightness."
    },
    {
      "start": 5.66,
      "end": 7.38,
      "text": "The suitcase is light enough to carry."
    },
    {
      "start": 7.96,
      "end": 9.8,
      "text": "Carry indicates light means not heavy."
    },
    {
      "start": 10.46,
      "end": 11.52,
      "text": "It's the same for pronouns."
    },
    {
      "start": 12.24,
      "end": 14.38,
      "text": "The cat drank the milk because it was thirsty."
    },
    {
      "start": 14.84,
      "end": 17.78,
      "text": "Thirsty describes the cat, so it refers to the cat."
    },
    {
      "start": 18.0,
      "end": 20.04,
      "text": "The cat drank the milk because it was fresh,"
    },
    {
      "start": 20.78,
      "end": 22.24,
      "text": "but fresh describes the milk,"
    },
    {
      "start": 22.5,
      "end": 23.8,
      "text": "pointing the pronoun to the milk."
    },
    {
      "start": 24.58,
      "end": 26.68,
      "text": "Attention and transformation help AI"
    },
    {
      "start": 26.68,
      "end": 28.04,
      "text": "work out which meaning fits."
    }
